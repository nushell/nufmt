let summary = match $value {
  "allow" if true => 1
  "some_name2" => 2
  "_name" => 3
  "true" => 4
  "false" => 5
  "null" => 6
  "_" => 7
  "NaN" => 8
  "inf" => 9
  "Infinity" => 10
  "n_a_n" => 11
  "_123" => 12
  "" => 13
  "two words" => 14
  "123" => 15
  "with-dash" => 16
  "a\tb" => 17
  "\u{61}llow" => 18
  'single' => 19
  r#'raw'# => 20
  ("constant") => 21
  true => 22
  false => 23
  null => 24
  42 => 25
  1..3 => 26
  _ => 0
}
