#!/usr/bin/env nu

def main [
    version: string  # the new version of Nushell, e.g. 0.116.0
] {
    print "updating the badge in the README"
    open --raw README.md
    | str replace --regex 'https://img.shields.io/badge/nushell-v\d+\.\d+\.\d+-green' $"https://img.shields.io/badge/nushell-v($version)-green"
    | collect
    | save --force README.md

    print "updating the `nu-cmd-lang` dependency"
    ^cargo add $"nu-cmd-lang@($version)"
    print "updating the `nu-parser` dependency"
    ^cargo add $"nu-parser@($version)"
    print "updating the `nu-protocol` dependency"
    ^cargo add $"nu-protocol@($version)"
    print "updating the `nuon` dependency"
    ^cargo add $"nuon@($version)"

    print "warning: do not forget to commit and push this :wink:"
}
